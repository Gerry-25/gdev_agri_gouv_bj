{
  "name": "agri-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @agri/web",
    "typecheck": "tsc -p packages/core && tsc -p apps/web",
    "test": "vitest run",
    "api:generate": "openapi-typescript openapi.json --default-non-nullable false -o packages/core/src/api/schema.d.ts",
    "api:pull": "curl -sf http://localhost:8000/openapi.json -o openapi.json && npm run api:generate",
    "dev": "npm run dev -w @agri/web"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.0.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
